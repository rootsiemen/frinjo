# Database
DATABASE_URL=file:./dev.db

# Site URL (used for OAuth callbacks)
NEXT_PUBLIC_SITE_URL=https://tarm.tech

# Google OAuth (from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=769835350425-p3rru2vdfqv6kbqri63bim0rcif5h2iv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here

# Admin login is managed in the database (admin_users table)

# Reset key for /admin/forgot-password (keep secret; anyone with this key can
# reset the admin password, so use a long random value)
#ADMIN_RESET_KEY=change-me-to-a-long-random-secret

# Email (SMTP) — for customer email verification + password resets.
# Example: Gmail — enable 2FA, create an App Password, then:
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-16-char-app-password
#SMTP_FROM=WebStore Pro <you@gmail.com>

# SMS alerts — order confirmations + status updates to customers,
# new-inquiry alerts to you. Pick ONE provider. If unset, SMS is only
# logged to the server console (dev fallback) and nothing breaks.
# Option A: Twilio
#SMS_PROVIDER=twilio
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-auth-token
#TWILIO_FROM=+1234567890
# Option B: generic HTTP gateway (e.g. a Pakistani SMS gateway) —
# put {to} and {message} placeholders in the URL:
#SMS_PROVIDER=url
#SMS_API_URL=https://gateway.example.com/send?api_key=KEY&to={to}&message={message}
#SMS_API_METHOD=GET
# Where new-inquiry alerts go (defaults to the WhatsApp number in site config):
#SMS_OWNER_NUMBER=+923001234567
